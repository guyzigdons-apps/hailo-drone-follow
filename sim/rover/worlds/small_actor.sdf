<?xml version="1.0" encoding="UTF-8"?>
<!--
  Rover-scale "small actor" world for v1.1.

  Why this world exists:
    The default Walking actor mesh is ~1.8 m tall. At the rover's camera
    height (~0.25 m), a person at any reasonable bbox size fills the rover's
    vertical FOV, and the rover can't get close enough to "follow" — RINT-02
    bottom-edge slow-down fires before the rover has done any useful motion.

    This world shrinks the actor to ~0.36 m (scale 0.2) and places the
    trajectory further away so the rover has room to drive forward + center
    + close in before RINT-02 stops it at the bottom-edge threshold.

  Differences from walk_across_then_approach.sdf (the drone-shaped rover world):
    - <skin>/<animation>/<scale> set to 0.2 → actor mesh shrinks ~5x.
    - Actor Z pose set to 0.18 (proportional to the canonical scale=1.0 / Z=0.9
      that the random_walk and circle_around worlds use to stand a full-size
      Walking actor with feet on the ground; 0.18 = 0.2 × 0.9).
    - X start pushed out to 5 (was 4 in the drone-shaped world, 2 in the
      previous small_actor revision); the rover has ~5 m of approach room
      before getting close.
    - Close-approach phase brings actor in to X=1.5 (rover-frame coordinates;
      rover at origin), keeping the actor at least 1.5 m away.  Combined with
      the smaller actor, this lands the actor at a sensible bbox height when
      RINT-02 fires.
    - Y sweep widened to ±4 (was ±3) to keep the sideways pass within the
      camera's horizontal FOV given the increased distance.

  Trajectory phases (small-actor scaled; times unchanged):
    Phase 0 (0..5):    hold at (5, -4), rover boots / drone-follow connects
    Phase 1 (5..17):   walk across frame at X=5 from Y=-4 to Y=+4
    Phase 2 (18..24):  return to centerline at (5, 0)
    Phase 3 (25..38):  turn and walk toward rover, X=5 → X=1.5
                       (stops 1.5 m from rover so RINT-02 fires at the
                       bbox-bottom threshold without contact)
    Phase 4 (39..72):  U-turn south of rover before returning to start
-->
<sdf version="1.9">
  <world name="small_actor">
    <include>
      <uri>model://rover</uri>
      <pose>0 0 0.15 0 0 0</pose>
    </include>

    <actor name="person">
      <skin>
        <filename>model://Walking actor/meshes/walk.dae</filename>
        <scale>0.2</scale>
      </skin>
      <animation name="walking">
        <filename>model://Walking actor/meshes/walk.dae</filename>
        <scale>0.2</scale>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walking">
          <!-- Phase 0: hold at (5,-4) for 5 s (rover boots, controller wakes) -->
          <waypoint>
            <time>0</time>
            <pose>5 -4 0.18 0 0 1.5708</pose>
          </waypoint>
          <waypoint>
            <time>5</time>
            <pose>5 -4 0.18 0 0 1.5708</pose>
          </waypoint>

          <!-- Phase 1: walk across frame, -Y to +Y at X=5 (~0.67 m/s for the
               small actor, scaled to feel natural at its body size) -->
          <waypoint>
            <time>17</time>
            <pose>5 4 0.18 0 0 1.5708</pose>
          </waypoint>

          <!-- Phase 2: turn around and walk back to centerline -->
          <waypoint>
            <time>18</time>
            <pose>5 4 0.18 0 0 -1.5708</pose>
          </waypoint>
          <waypoint>
            <time>24</time>
            <pose>5 0 0.18 0 0 -1.5708</pose>
          </waypoint>

          <!-- Phase 3: turn to face rover, walk straight toward it.
               3.5 m over 13 s (~0.27 m/s — slow approach scaled to actor
               size). Stops at X=1.5 — minimum follow distance, exercises
               RINT-02 bottom-edge slow-down WITHOUT colliding. -->
          <waypoint>
            <time>25</time>
            <pose>5 0 0.18 0 0 3.14159</pose>
          </waypoint>
          <waypoint>
            <time>38</time>
            <pose>1.5 0 0.18 0 0 3.14159</pose>
          </waypoint>

          <!-- Phase 4: U-turn south of rover before returning to start. -->
          <waypoint>
            <time>39</time>
            <pose>1.5 0 0.18 0 0 -1.5708</pose>
          </waypoint>
          <waypoint>
            <time>51</time>
            <pose>1.5 -8 0.18 0 0 -1.5708</pose>
          </waypoint>
          <waypoint>
            <time>52</time>
            <pose>1.5 -8 0.18 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>65</time>
            <pose>5 -8 0.18 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>66</time>
            <pose>5 -8 0.18 0 0 1.5708</pose>
          </waypoint>
          <waypoint>
            <time>72</time>
            <pose>5 -4 0.18 0 0 1.5708</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>

    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>
    <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
      <render_engine>ogre2</render_engine>
    </plugin>
    <gravity>0 0 -9.8</gravity>
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <surface>
            <friction><ode/></friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>1</mass>
          <inertia><ixx>1</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1</iyy><iyz>0</iyz><izz>1</izz></inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 0 0</pose>
      <self_collide>false</self_collide>
    </model>
    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
    </light>
  </world>
</sdf>
