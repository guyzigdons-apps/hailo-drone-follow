<?xml version="1.0" ?>
<!--
  Rover variant of sim/worlds/random_walk.sdf for Phase 5 v1.1.

  Differences from the drone source world:
    - Spawns the rover model directly via <include> (drone variant relied
      on PX4_GZ_WORLD).  Rover model is at sim/rover/rover.sdf — Plan
      05-05's start_rover_sim.sh exports
      GZ_SIM_RESOURCE_PATH=sim/rover:sim/worlds:... so this <include>
      resolves at launch.
    - Actor X coordinates scaled to 0.4x the drone-world values (rover sees
      from a 0.20 m camera at the same FOV the drone uses at ~3 m).  Y, Z,
      yaw, and time values are unchanged.
    - Drone-only world plugins (Imu, AirPressure) dropped — the rover has
      no IMU / barometer subsystem.
    - <magnetic_field> and <atmosphere> dropped (only feed the dropped
      plugins).
    - Actor renamed from "actor" to "person" so it matches the rover-world
      convention shared across walk_across_then_approach and circle_around.
-->
<sdf version="1.9">
  <world name="random_walk">
    <include>
      <uri>model://rover</uri>
      <pose>0 0 0.15 0 0 0</pose>
    </include>

    <!-- Environment setup (copied from 2_person_world.sdf) -->
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>
    <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
      <render_engine>ogre2</render_engine>
    </plugin>
    <gravity>0 0 -9.8</gravity>
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <light name="sunUTC" type="directional">
      <pose>0 0 250 0 -0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
    </light>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg> 8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <!-- The original actor definition (rover-scaled: X * 0.4, Y unchanged) -->
    <actor name="person">
       <skin>
          <filename>model://Walking actor/meshes/walk.dae</filename>
          <scale>1.0</scale>
       </skin>
       <animation name="walking">
          <filename>model://Walking actor/meshes/walk.dae</filename>
          <scale>1.000000</scale>
          <interpolate_x>true</interpolate_x>
       </animation>
       <script>
          <loop>true</loop>
          <delay_start>20.000000</delay_start>
          <auto_start>true</auto_start>
