__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
.env
*.log
logs/
recordings/
drone_follow/ui/node_modules/
drone_follow/ui/build/

# hailo-apps and sim/PX4-Autopilot are tracked as git submodules — see
# .gitmodules. Don't ignore them.

# Per-user Claude Code settings (shared memory/skills under .claude/ are tracked).
.claude/settings.local.json

# OpenHD repos cloned into the repo root by scripts/install_ground_station.sh.
# No trailing slash — that way the patterns match both real directories AND
# symlinks-to-directories (a real-dir-only pattern leaves symlinks untracked).
OpenHD
OpenHD-SysUtils
qopenHD

# Saved controller config — user tuning, not source (see PARAMETERS.md)
df_config.json

# OpenHD encryption key — never commit credentials
txrx.key

# GStreamer Shark profiling output
gstshark_*/

# Tiling benchmark run outputs + preview cache (frozen tiling_benchmark dir)
tiling_benchmark/pxt_runs*/

# Warmed tile caches (Plan 6) — large runtime artifacts, not source.
.tile_cache/

# GT-generation venv (large, never source)
.venv_gt/

# tiling_lab run artifacts: large, regenerable caches/frames dumps/gt trees.
# Ignore everything under runs/ EXCEPT the committed *.md summaries
# (BASELINE.md, ablation_table.md, legacy_dense/README.md, …). The
# unignore-dir pattern is REQUIRED so git descends into subdirs to find the
# *.md exception. Already-tracked files are unaffected by gitignore.
tiling_lab/runs/**
!tiling_lab/runs/**/
!tiling_lab/runs/**/*.md
